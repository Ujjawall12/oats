# Server Configuration
PORT=3000
MODE=dev

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/Ecommerce-App
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/Ecommerce-App
MONGO_URL=mongodb://127.0.0.1:27017/Ecommerce-App

# Base URL for serving static files
BASE_URL=http://localhost:3000/

# JWT Secret Key (Change this to a strong random string in production)
# Generate using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe Configuration (for payment processing)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
