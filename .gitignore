# Root level gitignore for Oats E-Commerce Project

# Environment variables (NEVER commit these!)
.env
.env.local
.env.development
.env.production
.env.test
*.env
# But DO commit .env.example files
!.env.example
**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Uploads (user uploaded files)
eCommerce-Backend/uploads/
!eCommerce-Backend/uploads/.gitkeep

# Temporary files
*.tmp
*.temp
.cache/

# Package manager locks (optional - some teams prefer to commit these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Testing
coverage/
.nyc_output/

# Misc
*.pem
*.key
*.cert
